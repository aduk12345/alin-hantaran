rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /categories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /standaloneProducts/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /siteContent/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /contentBlocks/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
